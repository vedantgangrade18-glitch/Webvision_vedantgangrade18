# Karu API configuration. Copy to .env and fill in what you have.
# Every external service is optional: without its key the API uses a clearly-labelled fake
# provider so all flows still work locally (Part 2 §1 "provider abstraction").

ENV=local                         # local | test | staging | prod
PUBLIC_BASE_URL=http://localhost:3000     # where QR codes and share links point
API_BASE_URL=http://localhost:3000       # browser-facing; the web app proxies /api/v1 and /media
CDN_BASE_URL=                     # public media base (S3/R2 + CDN); empty → served by the API at /media
CORS_ORIGINS=["http://localhost:3000"]

# Data stores
DATABASE_URL=sqlite+aiosqlite:///./var/karu.db     # prod: postgresql+asyncpg://user:pass@host:5432/karu
REDIS_URL=                        # e.g. redis://localhost:6379/0 (rate limits + Celery broker)
TASK_MODE=inline                  # inline (in-process jobs) | celery (workers + beat)
RUN_SCHEDULER=true                # in-process periodic jobs when TASK_MODE=inline

# Object storage
STORAGE_BACKEND=local             # local | s3
LOCAL_STORAGE_DIR=./var/media
S3_ENDPOINT=                      # e.g. https://<account>.r2.cloudflarestorage.com or http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET_PRIVATE=
S3_BUCKET_PUBLIC=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Security (generate real secrets outside local!)
JWT_SECRET=change-me-to-64-random-chars
FIELD_ENCRYPTION_KEY=             # base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
COOKIE_SECURE=false               # true behind HTTPS
ADMIN_TOTP_REQUIRED=true
WEB_REVALIDATE_SECRET=            # shared with the web app for on-demand ISR revalidation
WEB_INTERNAL_URL=http://localhost:3000

# AI / web intelligence
OPENAI_API_KEY=                   # Whisper speech-to-text
STT_PROVIDER=auto                 # auto | whisper | gemini | fake
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=gemini-3.8-flash
GEMINI_MODEL_VISION=gemini-3.8-flash
TINYFISH_API_KEY=                 # Search + Fetch (pricing, originality), Agent (Pehchan, demo syndication)
PEHCHAN_LOOKUP_URL=https://handicrafts.nic.in/
DEMO_SYNDICATION_CREDENTIALS_REF= # TinyFish Browser Context Profile id of the team's demo seller account

# Payments (Razorpay test keys for the demo)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LA_CATEGORY=ecommerce
RAZORPAY_LA_SUBCATEGORY=arts_and_collectibles

# Messaging
SMS_PROVIDER_KEY=                 # MSG91 auth key
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=KARUAI
WHATSAPP_TOKEN=                   # Meta WhatsApp Cloud API
WHATSAPP_PHONE_ID=
EMAIL_API_KEY=                    # Resend
EMAIL_FROM=Karu <hello@karu.ai>
GOOGLE_CLIENT_ID=                 # Google sign-in for buyers
KYC_PROVIDER_KEY=                 # DigiLocker KYC vendor (fake provider until a vendor is signed)

SENTRY_DSN=
